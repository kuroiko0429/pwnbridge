[Unit]
Description=Reconnect Pwnbridge Bluetooth PAN to the paired laptop
Wants=bluetooth.service NetworkManager.service
After=bluetooth.service NetworkManager.service

[Service]
Type=oneshot
EnvironmentFile=/etc/pwnbridge/pan.env
ExecStart=/usr/local/bin/pwnbridge-pan --profile ${PAN_PROFILE} --peer ${PAN_PEER}
TimeoutStartSec=30
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
